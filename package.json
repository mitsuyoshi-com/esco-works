{
  "name": "esco-ai",
  "version": "0.5.0",
  "description": "ESCO Works - エスコ社内AIアシスタント（クラウド版の画面を表示する殻＋指定メンバー向けエージェント）",
  "main": "main.js",
  "author": "ULTRIX",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-all.cjs",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.237",
    "electron-updater": "^6.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "jp.ultrix.esco-works",
    "productName": "ESCO Works",
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "config.js",
      "nameMatch.js",
      "login.js",
      "legacy.js",
      "importer.js",
      "updater.js",
      "agentMain.js",
      "agent.js",
      "sessions.js",
      "projects.js",
      "business.js",
      "folderQueue.js",
      "preload.js",
      "mcp/**",
      "renderer/**",
      "shell/**",
      "build/join-key.txt"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "ESCO-Works-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ESCO Works",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mitsuyoshi-com",
        "repo": "esco-works"
      }
    ]
  }
}
